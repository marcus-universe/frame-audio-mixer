[Unit]
Description=Frame Audio Mixer (dashboard panel)
# BindsTo, not only PartOf: if this panel starts while steamvr.service failed,
# VR_Init launches vrserver itself. Gamescope then aborts in rendervulkan
# (empty DRM modifiers) and the headset stays on a blank display.
After=steamvr.service
BindsTo=steamvr.service
PartOf=steamvr.service

[Service]
ExecStart=%h/.local/bin/frame-audio-mixer
Restart=always
RestartSec=5
RestartPreventExitStatus=3
SuccessExitStatus=3

[Install]
WantedBy=steamvr.service
